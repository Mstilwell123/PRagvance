# Copy to .env.local for local runs. Never commit real values.
# Server-only unless the name starts with NEXT_PUBLIC_.

# Shared store for rate limits, Stripe event dedupe, entitlements, and paid CRM markers.
# Required in production. Unset = per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# GoHighLevel. Both must be set or paid-checkout CRM sync is skipped
# and the contact form returns an error.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# Stripe checkout. Off unless CHECKOUT_ENABLED=true.
# Test keys on previews only. Do not put secret keys in NEXT_PUBLIC_ vars.
CHECKOUT_ENABLED=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRAGVANCE_STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override. Unset uses the live $497 price price_1UXucA83KSR7xg0bY4hd5r6H.
# price_1UXufc* and price_1UXufe* ($1 test prices) are ignored.
STRIPE_PRICE_SHADOW_LAB_GROUP=
# Optional override. Unset uses the live $997/month price price_1UXucC83KSR7xg0bzvpdDk9f.
STRIPE_PRICE_SHADOW_LAB_MONTHLY=
STRIPE_PRICE_CONSULTING=

# https URL for the paid 60-minute consultation booking page.
# Do not use the free 30-minute event. Leave unset until that page exists:
# /access/book then tells the buyer to email support@pragvance.ai.
CONSULTATION_BOOKING_URL=
