# Copy to .env.local for local runs. Never commit real values.
# Server-only unless the name starts with NEXT_PUBLIC_.

# Shared store for rate limits, Stripe event dedupe, entitlements, and paid CRM markers.
# Required in production. Unset = per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# GoHighLevel. Both must be set or paid-checkout CRM sync is skipped
# and the contact form returns an error.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# Stripe checkout. Off unless CHECKOUT_ENABLED=true.
# Test keys on previews only. Do not put secret keys in NEXT_PUBLIC_ vars.
CHECKOUT_ENABLED=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRAGVANCE_STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override. Unset uses the live $497 price price_1UXucA83KSR7xg0bY4hd5r6H.
# price_1UXufc* and price_1UXufe* ($1 test prices) are ignored.
STRIPE_PRICE_SHADOW_LAB_GROUP=
# Optional override. Unset uses the live $997/month price price_1UXucC83KSR7xg0bzvpdDk9f.
STRIPE_PRICE_SHADOW_LAB_MONTHLY=
STRIPE_PRICE_CONSULTING=
# Optional override. Unset uses the live $2,500 deposit price price_1UXv5983KSR7xg0b6Lpq66K8
# on product prod_VZ3By2B3NbN20I. price_1UXufc* and price_1UXufe* ($1 test prices) are ignored.
# A test-mode Stripe key cannot charge this live price.
STRIPE_PRICE_DONE_FOR_YOU=

# Single-use Calendly scheduling links, issued only after a paid Checkout Session.
# Both must be set. If either is missing or the event type is not an API URI,
# /access/book says we'll email the booking link. Never put a public Calendly page here.
# CALENDLY_EVENT_TYPE_URI looks like https://api.calendly.com/event_types/{id}
# and must be the 60-minute event. Unset the old CONSULTATION_BOOKING_URL if it is still
# on the host. This app does not read it.
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
# Optional. When unset, a Done-for-You deposit books CALENDLY_EVENT_TYPE_URI.
# Set a Calendly API event-type URI here when the kickoff should be a different event.
# A public calendly.com page is rejected.
CALENDLY_EVENT_TYPE_URI_DONE_FOR_YOU=
